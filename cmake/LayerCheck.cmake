# Layer check: lower layers must never link higher ones.
#   stx_layer(<target> <level>) records a target's architectural level.
#   stx_check_layers() fails the configure step if any recorded target links a target of a
#   higher level, and writes the dependency table used by the CTest re-check.
set_property(GLOBAL PROPERTY STX_LAYER_TARGETS "")

function(stx_layer target level)
  set_property(TARGET ${target} PROPERTY STX_LEVEL ${level})
  set_property(GLOBAL APPEND PROPERTY STX_LAYER_TARGETS ${target})
endfunction()

function(stx_check_layers)
  get_property(targets GLOBAL PROPERTY STX_LAYER_TARGETS)
  set(table "")
  set(errors "")
  foreach(t IN LISTS targets)
    get_target_property(lt ${t} STX_LEVEL)
    get_target_property(libs ${t} LINK_LIBRARIES)
    if(NOT libs)
      set(libs "")
    endif()
    foreach(l IN LISTS libs)
      string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" l "${l}")
      if(TARGET ${l})
        get_target_property(ll ${l} STX_LEVEL)
        if(NOT ll STREQUAL "ll-NOTFOUND")
          string(APPEND table "${t};${lt};${l};${ll}\n")
          if(ll GREATER lt)
            string(APPEND errors "  ${t} (level ${lt}) links ${l} (level ${ll})\n")
          endif()
        endif()
      endif()
    endforeach()
  endforeach()
  file(WRITE ${CMAKE_BINARY_DIR}/layer_dependencies.txt "${table}")
  if(errors)
    message(FATAL_ERROR "Layer check failed: a lower layer links a higher one\n${errors}")
  else()
    message(STATUS "Layer check passed")
  endif()
endfunction()
