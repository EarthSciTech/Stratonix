# CPack: portable zip on both platforms, NSIS installer on Windows, tar.gz on Linux.
set(CPACK_PACKAGE_NAME "Stratonix")
set(CPACK_PACKAGE_VENDOR "Stratonix workstream")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Stratonix geomodelling toolkit")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Stratonix")
set(CPACK_RESOURCE_FILE_README ${CMAKE_CURRENT_SOURCE_DIR}/README.md)
set(CPACK_RESOURCE_FILE_LICENSE ${CMAKE_CURRENT_SOURCE_DIR}/LICENSE)
set(CPACK_PACKAGE_CHECKSUM SHA256)
if(WIN32)
  set(CPACK_GENERATOR "ZIP;NSIS")
  set(CPACK_NSIS_MODIFY_PATH ON)
  set(CPACK_NSIS_DISPLAY_NAME "Stratonix ${PROJECT_VERSION}")
  set(CPACK_NSIS_PACKAGE_NAME "Stratonix")
else()
  set(CPACK_GENERATOR "TGZ;ZIP")
endif()
set(CPACK_PACKAGE_FILE_NAME "stratonix-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
install(FILES README.md CHANGELOG.md LICENSE THIRD_PARTY.md DESTINATION share/doc/stratonix)
install(FILES docs/user_guide.md docs/developer_guide.md docs/api_reference.md docs/roadmap.md docs/package_config.md
              docs/performance_and_threading.md DESTINATION share/doc/stratonix)
install(DIRECTORY examples/ DESTINATION share/stratonix/examples PATTERN "broken" EXCLUDE)
install(FILES schema/stratonix_schema_v1.json DESTINATION share/stratonix/schema)
# Stage 4C (STX-TN-16 section 4): the package states its optional readers and exporters
set(STX_COMPONENTS "Stratonix ${PROJECT_VERSION} - optional components of this package (also: stratonix version)\n")
foreach(c IN ITEMS "RESQML 2.0.1 export (FESAPI, Apache 2.0)|STRATONIX_WITH_FESAPI" "coordinate transformations (PROJ, MIT)|STRATONIX_WITH_PROJ"
               "GeoPackage maps (SQLite, public domain)|SQLite3_FOUND")
  string(REPLACE "|" ";" cv "${c}")
  list(GET cv 0 cname)
  list(GET cv 1 cvar)
  if(${cvar})
    string(APPEND STX_COMPONENTS "  ${cname}: included\n")
  else()
    string(APPEND STX_COMPONENTS "  ${cname}: not included\n")
  endif()
endforeach()
string(APPEND STX_COMPONENTS "  LAS 2.0/3.0 and DLIS (RP66 V1) well data: included\n  SEG-Y revisions 0 to 2.1: included\n")
if((STRATONIX_WITH_FESAPI OR STRATONIX_WITH_PROJ) AND NOT WIN32)
  string(APPEND STX_COMPONENTS "On Linux these use the system's HDF5, minizip and PROJ libraries (Ubuntu 22.04: apt install libhdf5-103-1 libminizip1 libproj22).\n")
endif()
file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/COMPONENTS.txt "${STX_COMPONENTS}")
install(FILES ${CMAKE_CURRENT_BINARY_DIR}/COMPONENTS.txt DESTINATION share/doc/stratonix)
include(CPack)
