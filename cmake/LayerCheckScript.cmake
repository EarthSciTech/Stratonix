# Re-check the recorded layer dependency table (run by CTest): cmake -DTABLE=<file> -P LayerCheckScript.cmake
file(STRINGS ${TABLE} lines)
set(n 0)
foreach(line IN LISTS lines)
  string(REPLACE ";" "|" line "${line}")
  string(REPLACE "|" ";" parts "${line}")
  list(GET parts 0 t)
  list(GET parts 1 lt)
  list(GET parts 2 l)
  list(GET parts 3 ll)
  math(EXPR n "${n}+1")
  if(ll GREATER lt)
    message(FATAL_ERROR "layer violation: ${t} (${lt}) -> ${l} (${ll})")
  endif()
endforeach()
if(n EQUAL 0)
  message(FATAL_ERROR "layer table is empty")
endif()
message(STATUS "layer check: ${n} dependencies, no violations")
