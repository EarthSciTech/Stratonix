{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "stratonix",
  "version": "2026.4.1",
  "description": "Stratonix geomodelling toolkit",
  "dependencies": [
    "libyaml",
    "zlib",
    {
      "name": "cairo",
      "default-features": false,
      "platform": "!uwp"
    }
  ],
  "features": {
    "proj": {
      "description": "Coordinate reprojection with PROJ",
      "dependencies": [
        "proj"
      ]
    },
    "sqlite": {
      "description": "GeoPackage maps through SQLite",
      "dependencies": [
        "sqlite3"
      ]
    }
  }
}
